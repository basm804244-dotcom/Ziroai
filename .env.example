# ═══════════════════════════════════════════════════════════════
# AetherAI Platform - Ultimate Edition 2026
# Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── General ──────────────────────────────────────────────────
APP_NAME=AetherAI
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
API_URL=http://localhost:8080

# ─── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aether
POSTGRES_PASSWORD=aether_secret_2026
POSTGRES_DB=aether_platform
POSTGRES_POOL_SIZE=20

# ─── Redis ────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Vector DB (Qdrant) ──────────────────────────────────────
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=

# ─── Graph DB (Neo4j) ─────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=aether_neo4j_2026

# ─── Analytics (ClickHouse) ───────────────────────────────────
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=aether_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ─── Search (Elasticsearch) ───────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=aether_es_2026

# ─── Storage (MinIO) ──────────────────────────────────────────
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=aether_minio
MINIO_SECRET_KEY=aether_minio_secret_2026
MINIO_BUCKET=aether-storage
MINIO_PUBLIC_URL=http://localhost:9000

# ─── AI Model Providers ───────────────────────────────────────
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Google Gemini
GOOGLE_API_KEY=your-google-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# xAI Grok
XAI_API_KEY=your-xai-key
GROK_BASE_URL=https://api.x.ai/v1

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Mistral
MISTRAL_API_KEY=your-mistral-key
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Cohere
COHERE_API_KEY=your-cohere-key

# ─── Local Models (vLLM/Ollama) ───────────────────────────────
VLLM_HOST=http://vllm:8000
OLLAMA_HOST=http://ollama:11434
LOCAL_MODELS_ENABLED=true

# ─── HuggingFace ──────────────────────────────────────────────
HF_TOKEN=hf_your_token
HF_CACHE_DIR=/app/.cache/huggingface

# ─── Authentication ───────────────────────────────────────────
JWT_SECRET=aether_jwt_super_secret_2026_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=3600
JWT_REFRESH_TOKEN_EXPIRE=604800

# OAuth2
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# MFA
MFA_TOTP_ISSUER=AetherAI
WEBAUTHN_RP_NAME=AetherAI
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ─── Stripe Billing ───────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_FREE=price_free
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# ─── Email / Notifications ────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-key
EMAIL_FROM=noreply@aether.ai

# ─── Monitoring ───────────────────────────────────────────────
PROMETHEUS_RETENTION=30d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=aether_grafana_2026
JAEGER_ENDPOINT=http://jaeger:14268/api/traces
SENTRY_DSN=

# ─── Security ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=150
WAF_ENABLED=true
DDOS_PROTECTION=true

# ─── Feature Flags ────────────────────────────────────────────
FEATURE_AGENTS=true
FEATURE_MEMORY=true
FEATURE_RAG=true
FEATURE_WORKSPACE=true
FEATURE_BILLING=true
FEATURE_ANALYTICS=true
FEATURE_MARKETPLACE=true
FEATURE_MCP=true
FEATURE_A2A=true
FEATURE_LOCAL_MODELS=true
FEATURE_COMPUTER_USE=true
FEATURE_CODE_SANDBOX=true
